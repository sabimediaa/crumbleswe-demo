{
  "hosting": {
    "predeploy": [
      "bash scripts/build-site.sh"
    ],
    "public": "site",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      { "source": "/bilder/exempel-stad.jpg", "destination": "/bilder/exempel-stadforetag.jpg", "type": 301 },
      { "source": "/bilder/exempel-stad-400.webp", "destination": "/bilder/exempel-stadforetag-400.webp", "type": 301 },
      { "source": "/bilder/exempel-stad-680.webp", "destination": "/bilder/exempel-stadforetag-680.webp", "type": 301 },
      { "source": "/bilder/exempel-stad-960.webp", "destination": "/bilder/exempel-stadforetag-960.webp", "type": 301 }
    ],
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/!(*.@(jpg|png|webp|ico|woff2))",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|png|webp|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/kontakt",
        "function": {
          "functionId": "kontakt",
          "region": "europe-north1"
        }
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 8765
    },
    "ui": {
      "enabled": false
    },
    "functions": {
      "port": 5001
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.local",
        "firebase-debug.log"
      ]
    }
  ]
}
